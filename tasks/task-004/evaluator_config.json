{
  "acceptance_score": 80,
  "allowed_paths": [
    "src/**",
    "CANDIDATE_NOTES.md"
  ],
  "build_failure_class": "compile_error",
  "commands": {
    "benchmark": [
      "bash",
      "scripts/run_benchmark.sh"
    ],
    "build": [
      "bash",
      "scripts/build.sh"
    ],
    "determinism": [
      "bash",
      "scripts/determinism.sh"
    ],
    "format": [
      "bash",
      "scripts/format_check.sh"
    ],
    "held_out_tests": [
      "bash",
      "scripts/run_held_out.sh"
    ],
    "lint": [
      "bash",
      "scripts/build.sh"
    ],
    "public_tests": [
      "bash",
      "scripts/run_public.sh"
    ],
    "regression_tests": [
      "bash",
      "scripts/run_regression.sh"
    ]
  },
  "language": "Java",
  "output_limit_bytes": 200000,
  "performance": {
    "direction": "lower",
    "metric": "allocation_units",
    "path": "benchmark_result.json",
    "threshold": 12
  },
  "required_documentation": [
    "CANDIDATE_NOTES.md"
  ],
  "task_id": "task-004",
  "timeout_seconds": 60,
  "weights": {
    "benchmark": 10,
    "build": 15,
    "determinism": 5,
    "format": 5,
    "held_out_tests": 20,
    "lint": 5,
    "public_tests": 25,
    "regression_tests": 15
  }
}
